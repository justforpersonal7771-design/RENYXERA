# GEMINI_API_KEY: Required for Gemini AI API calls.
# SERVER-SIDE ONLY — do NOT prefix with NEXT_PUBLIC_, that would ship it to
# every visitor's browser. Only app/api/ai/**/route.ts handlers may read it.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Supabase (Module 4B) ---
# From your Supabase project: Project Settings -> API.

# Safe to be public — this key is scoped by Row Level Security (see
# supabase/migrations/0001_init.sql), not by secrecy. Ships to the browser.
NEXT_PUBLIC_SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Supabase renamed "anon key" to "publishable key" during 2026; use whichever your
# dashboard shows you (lib/supabase/env.ts accepts either name).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY="MY_SUPABASE_PUBLISHABLE_KEY"
# NEXT_PUBLIC_SUPABASE_ANON_KEY="MY_SUPABASE_ANON_KEY"   # legacy name, same purpose

# SERVER-SIDE ONLY — never prefix with NEXT_PUBLIC_. Bypasses Row Level Security
# entirely. Only lib/supabase/service-role.ts may read this (enforced at build time by
# the `server-only` import in that file — importing it from client code fails the build).
SUPABASE_SERVICE_ROLE_KEY="MY_SUPABASE_SERVICE_ROLE_KEY"
