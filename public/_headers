# Cloudflare static-asset headers (OpenNext reads this file). Build output in /_next/static has a content hash in its name, so it can be cached for a year.
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/brand/*
  Cache-Control: public, max-age=604800, stale-while-revalidate=86400
/screenshots/*
  Cache-Control: public, max-age=604800
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
